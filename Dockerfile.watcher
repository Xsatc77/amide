# The base image is pinned by digest (the multi-arch index of python:3.13-slim). Dependabot proposes new digests weekly; to refresh by hand,
# read the Docker-Content-Digest of the python:3.13-slim manifest list (docker buildx imagetools inspect python:3.13-slim) and paste it here.
FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    AMIDE_WATCHER_HOME=/watcher-data

# zlib1g is upgraded so the image takes the Debian security update of it even when the pinned base image is older.
RUN apt-get update && apt-get install -y --no-install-recommends --only-upgrade zlib1g && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# From the hash-pinned lock (requirements-watcher.lock, made by tools/make_lock.py). pyaes (a Telethon dependency) ships only as a
# source archive; its hash is still checked, and pip builds it with setuptools fetched into pip's isolated build environment.
COPY requirements-watcher.lock .
# pip, setuptools and wheel are removed afterwards: the watcher never needs them at run time, and the copies of urllib3, msgpack and setuptools
# they bundle are what image scanners flag.
RUN pip install --no-cache-dir --require-hashes --no-deps -r requirements-watcher.lock && pip uninstall -y pip setuptools wheel

# Only the watcher package: it imports nothing from the Amide app.
COPY watcher ./watcher

RUN useradd --create-home --uid 1000 watcher && mkdir -p /watcher-data && chown watcher:watcher /watcher-data
USER watcher
VOLUME ["/watcher-data"]

CMD ["python", "-m", "watcher", "serve"]
