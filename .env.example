# Copy this file to .env and adjust. Docker Compose reads .env automatically.
#
# Amide: Every Dose, Linked
# Inventory, protocol, and dose tracking for research peptides and medicines

# ============================================================================
# DEPLOYMENT
# ============================================================================

# Port to access Amide from your browser: http://<server>:AMIDE_PORT
AMIDE_PORT=1707

# Application environment
ENVIRONMENT=development

# ============================================================================
# SECURITY (MUST configure in production)
# ============================================================================

# Secret key for session management and encryption
# Generate a new one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# ============================================================================
# DATABASE
# ============================================================================

# SQLite (default, single-user deployment):
DATABASE_URL=sqlite:////data/amide.db

# PostgreSQL (multi-user, production):
# DATABASE_URL=postgresql://username:password@postgres:5432/amide

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=info

# ============================================================================
# FEATURES (Optional)
# ============================================================================

# Enable/disable specific features
ENABLE_SHARING=true
ENABLE_API_DOCS=true
