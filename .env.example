# Copy this file to .env and adjust. Docker Compose reads .env automatically.

# Port Amide is reachable on from your browser: http://<server>:AMIDE_PORT
AMIDE_PORT=1707

# Optional: the address the compose file publishes on (default all interfaces). Use 127.0.0.1 when a reverse proxy on this machine is the only way in.
# AMIDE_BIND=127.0.0.1
# Optional: the public https address people use (turns on Secure cookies and fixes the passkey site name).
# AMIDE_PUBLIC_URL=https://amide.example.test
# Optional: open or closed forces New User sign-up (otherwise the admin's switch in Settings decides).
# AMIDE_REGISTRATION=closed
# Optional: the only hosts the "My own server" AI address may use (comma separated hosts or CIDRs), and whether the container's own loopback is allowed.
# AMIDE_AI_LOCAL_ALLOWED_HOSTS=192.168.1.5
# AMIDE_AI_ALLOW_LOOPBACK=1
